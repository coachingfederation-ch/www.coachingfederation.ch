{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "eslint.config.js"],
  // The attached design system ships showcase chrome (SiteHeader/SiteFooter)
  // whose <Link> targets are the library project's own routes (/brand,
  // /components, …). Those routes don't exist here, so TanStack Router's typed
  // links reject them. The vendor copy must not be edited (it is overwritten on
  // every design-system update), and the app uses its own chrome, so the
  // vendored subtree is kept out of the app typecheck. Vite still compiles it.
  "exclude": ["src/design-system/**"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
